# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Origen(es) permitido(s), separados por coma si necesitas más de uno.
FRONTEND_URL="https://ros-tob.web.app,http://localhost:4200"

# Secretos obligatorios. Usa valores aleatorios y no los subas al repositorio.
JWT_SECRET="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"
INITIAL_ADMIN_PASSWORD="define-una-clave-inicial-segura-de-12-caracteres"
INITIAL_SELLER_PASSWORD="define-otra-clave-inicial-segura-de-12-caracteres"

# SMTP para verificación y recuperación de contraseña.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="tu-contraseña-de-aplicacion"
MAIL_FROM="ROS-TOB <tu-correo@gmail.com>"
