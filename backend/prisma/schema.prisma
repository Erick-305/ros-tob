// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Book {
  id                 Int                 @id(map: "book_pkey") @default(autoincrement())
  active             Boolean             @default(true)
  author             String
  barcode            String              @unique(map: "book_barcode_key")
  category           String
  cost               Numeric
  createdAt          TimestamptzString   @default(now())
  minStock           Int                 @default(0)
  salePrice          Numeric
  stock              Int                 @default(0)
  title              String
  updatedAt          TimestamptzString   @default(now())
  inventoryMovements InventoryMovement[]
  returnItems       SalesReturnItem[]
  saleItems          SaleItem[]
  supplierPurchaseItems SupplierPurchaseItem[]

  @@map("book")
}

model Customer {
  id        Int               @id(map: "customer_pkey") @default(autoincrement())
  active    Boolean           @default(true)
  address   String?
  createdAt TimestamptzString @default(now())
  email     String?
  name      String
  phone     String?
  taxId     String?
  updatedAt TimestamptzString @default(now())
  city      String?
  sales     Sale[]

  @@map("customer")
}

model User {
  id                    Int                 @id(map: "user_pkey") @default(autoincrement())
  active                Boolean             @default(true)
  createdAt             TimestamptzString   @default(now())
  email                 String?             @unique(map: "user_email_key")
  emailVerified         Boolean             @default(false)
  name                  String
  passwordHash          String
  resetCode             String?
  resetExpiresAt        TimestamptzString?
  role                  String              @default("SELLER")
  updatedAt             TimestamptzString   @default(now())
  username              String              @unique(map: "user_username_key")
  verificationCode      String?
  verificationExpiresAt TimestamptzString?
  inventoryMovements    InventoryMovement[]
  salesReturns          SalesReturn[]
  supplierPurchases     SupplierPurchase[]
  sales                 Sale[]

  @@map("user")
}

model InventoryMovement {
  id            Int               @id(map: "inventoryMovement_pkey") @default(autoincrement())
  bookId        Int
  createdAt     TimestamptzString @default(now())
  newStock      Int
  previousStock Int
  quantity      Int
  reason        String
  supplierId    Int?
  type          String            @map("type")
  unitCost      Numeric?
  userId        Int
  book          Book        @relation(fields: [bookId], references: [id], map: "inventoryMovement_bookId_fkey")
  supplier      Supplier?   @relation(fields: [supplierId], references: [id], map: "inventoryMovement_supplierId_fkey")
  user          User        @relation(fields: [userId], references: [id], map: "inventoryMovement_userId_fkey")

  @@index([bookId], name: "inventoryMovement_bookId_idx")
  @@index([supplierId], name: "inventoryMovement_supplierId_idx")
  @@index([userId], name: "inventoryMovement_userId_idx")
  @@map("inventoryMovement")
}

model Supplier {
  id                 Int                 @id(map: "supplier_pkey") @default(autoincrement())
  name               String
  contactName        String?
  phone              String?
  email              String?
  address            String?
  notes              String?
  createdAt          TimestamptzString   @default(now())
  updatedAt          TimestamptzString   @default(now())
  inventoryMovements InventoryMovement[]
  purchases          SupplierPurchase[]

  @@map("supplier")
}

model Sale {
  id                Int               @id(map: "sale_pkey") @default(autoincrement())
  createdAt         TimestamptzString @default(now())
  customerId        Int?
  customerName      String?
  customerTaxId     String?
  number            Int         @unique(map: "sale_number_key")
  receivedConfirmed Boolean     @default(false)
  receivedId        String?
  receivedName      String?
  shippingActive    Boolean     @default(false)
  shippingAddress   String?
  shippingAmount    Numeric     @default("0")
  shippingNote      String?
  shippingReference String?
  status            String      @default("COMPLETED")
  subtotal          Numeric
  userId            Int
  sellerName        String?
  saleItems         SaleItem[]
  salesReturns       SalesReturn[]
  customer          Customer?   @relation(fields: [customerId], references: [id], map: "sale_customerId_fkey")
  user              User        @relation(fields: [userId], references: [id], map: "sale_userId_fkey")

  @@index([customerId], name: "sale_customerId_idx")
  @@index([userId], name: "sale_userId_idx")
  @@map("sale")
}

model SaleItem {
  id          Int     @id(map: "saleItem_pkey") @default(autoincrement())
  barcode     String
  bookId      Int
  description String
  quantity    Int
  saleId      Int
  total       Numeric
  unitPrice   Numeric
  book        Book    @relation(fields: [bookId], references: [id], map: "saleItem_bookId_fkey")
  sale        Sale    @relation(fields: [saleId], references: [id], map: "saleItem_saleId_fkey")
  returnItems SalesReturnItem[]

  @@index([bookId], name: "saleItem_bookId_idx")
  @@index([saleId], name: "saleItem_saleId_idx")
  @@map("saleItem")
}

model SalesReturn {
  id           Int                 @id(map: "salesReturn_pkey") @default(autoincrement())
  saleId       Int
  userId       Int
  reason       String
  refundAmount Numeric
  createdAt    TimestamptzString   @default(now())
  sale         Sale                @relation(fields: [saleId], references: [id], map: "salesReturn_saleId_fkey")
  user         User                @relation(fields: [userId], references: [id], map: "salesReturn_userId_fkey")
  items        SalesReturnItem[]

  @@index([saleId], name: "salesReturn_saleId_idx")
  @@index([userId], name: "salesReturn_userId_idx")
  @@map("salesReturn")
}

model SalesReturnItem {
  id          Int         @id(map: "salesReturnItem_pkey") @default(autoincrement())
  returnId    Int
  saleItemId  Int
  bookId      Int
  quantity    Int
  unitPrice   Numeric
  return      SalesReturn @relation(fields: [returnId], references: [id], map: "salesReturnItem_returnId_fkey")
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id], map: "salesReturnItem_saleItemId_fkey")
  book        Book        @relation(fields: [bookId], references: [id], map: "salesReturnItem_bookId_fkey")

  @@index([returnId], name: "salesReturnItem_returnId_idx")
  @@index([saleItemId], name: "salesReturnItem_saleItemId_idx")
  @@map("salesReturnItem")
}

model SupplierPurchase {
  id            Int                   @id(map: "supplierPurchase_pkey") @default(autoincrement())
  supplierId    Int
  userId        Int
  invoiceNumber String?
  notes         String?
  subtotal      Numeric
  createdAt     TimestamptzString     @default(now())
  supplier      Supplier              @relation(fields: [supplierId], references: [id], map: "supplierPurchase_supplierId_fkey")
  user          User                  @relation(fields: [userId], references: [id], map: "supplierPurchase_userId_fkey")
  items         SupplierPurchaseItem[]

  @@index([supplierId], name: "supplierPurchase_supplierId_idx")
  @@index([userId], name: "supplierPurchase_userId_idx")
  @@map("supplierPurchase")
}

model SupplierPurchaseItem {
  id          Int              @id(map: "supplierPurchaseItem_pkey") @default(autoincrement())
  purchaseId  Int
  bookId      Int
  description String
  quantity    Int
  unitCost    Numeric
  total       Numeric
  purchase    SupplierPurchase @relation(fields: [purchaseId], references: [id], map: "supplierPurchaseItem_purchaseId_fkey")
  book        Book             @relation(fields: [bookId], references: [id], map: "supplierPurchaseItem_bookId_fkey")

  @@index([purchaseId], name: "supplierPurchaseItem_purchaseId_idx")
  @@index([bookId], name: "supplierPurchaseItem_bookId_idx")
  @@map("supplierPurchaseItem")
}
